# Select an immutable Git tag from https://github.com/discourse/discourse/tags
# or a supported moving channel: latest, release, esr.
# For production, prefer an explicit version tag and pin the resolved commit in release metadata.
DISCOURSE_REF=release

# Pin the Docker build definitions independently. Use an immutable commit SHA.
DISCOURSE_DOCKER_REF=<40-character-commit-sha>

# Optional: pin base image by digest for reproducible builds.
DISCOURSE_BASE_IMAGE=discourse/base@sha256:<verified-digest>
